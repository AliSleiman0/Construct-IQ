# =============================================================================
# ConstructIQ — production env for docker-compose.prod.yml
# Copy to deploy/.env.prod and fill in real values. NEVER commit deploy/.env.prod.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#
# Hostnames (mongo, redis, minio, backend) are Docker service names — leave them
# as-is for the all-in-one droplet. Replace <DROPLET_IP> with the droplet's
# public IPv4 (no http:// in the IP itself; keep the scheme shown).
# =============================================================================

# ---- Core ----
NODE_ENV=production
PORT=4000

# Mongo runs as the `mongo` service (single-node replica set rs0).
MONGO_URL=mongodb://mongo:27017/constructiq?replicaSet=rs0&directConnection=true

# ---- Auth secrets — generate unique values, do NOT ship the examples ----
#   openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies: true in production (TLS terminates at nginx). Only set false if
# serving over plain HTTP (browser drops Secure cookies on HTTP).
COOKIE_SECURE=true

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---- Public origin (browser-facing) ----
FRONTEND_URL=https://constructiq.site

# Baked into the frontend build + used for SSR fetch. Internal service URL;
# the browser uses the relative /api/v1 path via nginx, so this stays internal.
NEXT_PUBLIC_API_URL=http://backend:4000

# ---- First-boot super admin (seeded by the `seed` profile) ----
SUPER_ADMIN_EMAIL=admin@yourcompany.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---- File storage (MinIO, S3-compatible) ----
# S3_ACCESS_KEY/S3_SECRET_KEY double as the MinIO root user/password.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=constructiq
S3_ACCESS_KEY=CHANGE_ME_minio_access_key
S3_SECRET_KEY=CHANGE_ME_minio_secret_key
S3_REGION=us-east-1
# Browser-facing base URL for uploaded files. MUST include the bucket name:
# the API returns `${S3_PUBLIC_URL}/${key}`, and nginx maps /storage/ → minio.
S3_PUBLIC_URL=https://constructiq.site/storage/constructiq

# ---- AI (REQUIRED for boot) ----
# The AI module builds its OpenAI client at startup and is eagerly imported, so
# the backend crash-loops without a valid key. Use a rotated key.
OPENAI_API_KEY=sk-CHANGE_ME
AI_MODEL=gpt-4o-mini

# ---- Autodesk APS (optional — CAD drawing viewer; 503 until set) ----
# APS_CLIENT_ID=
# APS_CLIENT_SECRET=
# APS_BUCKET_KEY=constructiq-drawings
