# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Mark auth cookies Secure (requires HTTPS). Leave false/unset over plain HTTP.
COOKIE_SECURE=false

# Database
# Replica set is required for Mongoose transactions (see auth/org-provisioning flows).
# directConnection=true skips SDAM host discovery, which is mandatory when
# connecting from outside the Docker network where the replica set's advertised
# host ("mongo") is not resolvable.
MONGO_URL="mongodb://localhost:27017/constructiq?replicaSet=rs0&directConnection=true"

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Super Admin credentials (used by the seed script)
# CHANGE THESE IN PRODUCTION
SUPER_ADMIN_EMAIL=admin@constructiq.com
SUPER_ADMIN_PASSWORD=Admin@1234

# AI
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Storage — required for org logo uploads (and other file uploads in later phases).
# Leave S3_BUCKET unset to disable uploads (the endpoint will return 503).
# For local dev with MinIO, set S3_ENDPOINT=http://localhost:9000 and S3_PUBLIC_URL accordingly.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# Autodesk Platform Services (APS) — required for the AutoCAD engineer portal.
# Register a free app at https://aps.autodesk.com/ to get credentials.
# Leave APS_CLIENT_ID unset to disable the APS viewer (uploads still work but drawings
# won't be viewable in-browser — they'll show as "not configured").
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Bucket key must be globally unique across all Autodesk accounts (lowercase, 3-128 chars).
APS_BUCKET_KEY=constructiq-drawings
