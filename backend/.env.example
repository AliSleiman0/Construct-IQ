# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://constructiq:constructiq_secret@localhost:5432/constructiq_db?schema=public"

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Super Admin credentials (used by the seed script)
# CHANGE THESE IN PRODUCTION
SUPER_ADMIN_EMAIL=admin@constructiq.com
SUPER_ADMIN_PASSWORD=Admin@1234

# AI (add in Phase 7)
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Storage (add in Phase 6)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
