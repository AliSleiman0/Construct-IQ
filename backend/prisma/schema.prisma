// ConstructIQ — Complete Prisma Schema
// Version: 2.0 — MongoDB
// All MVP models defined upfront

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssueType {
  GENERAL
  TECHNICAL
  QUALITY
  SAFETY
  PROCUREMENT
  BUDGET
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  DELAYED
  CANCELLED
}

enum DocumentType {
  DRAWING
  REPORT
  CONTRACT
  PURCHASE_DOCUMENT
  TECHNICAL_FILE
  IMAGE
  OTHER
}

enum AIInsightType {
  DELAY_RISK
  COST_OVERRUN
  PROCUREMENT_DELAY
  SAFETY_CONCERN
  GENERAL
}

enum AIInsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  GENERAL
  BILLING
  TECHNICAL
  FEATURE_REQUEST
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

// ─────────────────────────────────────────
// IDENTITY & ACCESS
// ─────────────────────────────────────────

model Organization {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  website   String?
  maxUsers  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  projects         Project[]
  roles            Role[]
  suppliers        Supplier[]
  aiInsights       AIInsight[]
  chatSessions     ChatSession[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  supportTickets   SupportTicket[]
  orgSettings      OrgSettings?
}

model User {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String?    @db.ObjectId
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  isExternal     Boolean    @default(false)
  supplierId     String?    @db.ObjectId
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  refreshToken   String?
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization?   @relation(fields: [organizationId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  userRoles      UserRole[]
  projectMembers ProjectMember[]

  assignedTasks  Task[]  @relation("TaskAssignee")
  createdTasks   Task[]  @relation("TaskCreator")
  assignedIssues Issue[] @relation("IssueAssignee")
  createdIssues  Issue[] @relation("IssueCreator")

  dailyReports    DailyReport[]
  chatSessions    ChatSession[]
  chatMessages    ChatMessage[]
  notifications   Notification[]  @relation("NotificationUser")
  auditLogs       AuditLog[]
  createdTickets  SupportTicket[] @relation("TicketCreator")
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  ticketComments  TicketComment[]

  @@index([organizationId])
  @@index([email])
}

model Role {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
}

model Permission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  roleId    String   @db.ObjectId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String   @db.ObjectId
  permissionId String   @db.ObjectId
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// ─────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────

model Project {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @db.ObjectId
  name           String
  description    String?
  code           String?
  location       String?
  status         ProjectStatus @default(PLANNING)
  startDate      DateTime?
  endDate        DateTime?
  totalBudget    Float?
  currency       String        @default("USD")
  createdById    String?       @db.ObjectId
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  members        ProjectMember[]
  phases         Phase[]
  milestones     Milestone[]
  tasks          Task[]
  dailyReports   DailyReport[]
  issues         Issue[]
  budget         Budget?
  documents      Document[]
  aiInsights     AIInsight[]
  chatSessions   ChatSession[]
  auditLogs      AuditLog[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
}

model ProjectMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  userId    String   @db.ObjectId
  role      String?
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Phase {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @db.ObjectId
  projectId      String        @db.ObjectId
  name           String
  description    String?
  order          Int           @default(0)
  startDate      DateTime?
  endDate        DateTime?
  status         ProjectStatus @default(PLANNING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project    Project     @relation(fields: [projectId], references: [id])
  milestones Milestone[]
  tasks      Task[]

  @@index([projectId])
  @@index([organizationId])
}

model Milestone {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @db.ObjectId
  projectId      String        @db.ObjectId
  phaseId        String?       @db.ObjectId
  name           String
  description    String?
  targetDate     DateTime?
  completedDate  DateTime?
  status         ProjectStatus @default(PLANNING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  phase   Phase?  @relation(fields: [phaseId], references: [id])

  @@index([projectId])
  @@index([organizationId])
}

// ─────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────

model Task {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  projectId      String       @db.ObjectId
  phaseId        String?      @db.ObjectId
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assignedToId   String?      @db.ObjectId
  createdById    String?      @db.ObjectId
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  progress       Int          @default(0)
  estimatedHours Float?
  actualHours    Float?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project    Project @relation(fields: [projectId], references: [id])
  phase      Phase?  @relation(fields: [phaseId], references: [id])
  assignedTo User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User?   @relation("TaskCreator", fields: [createdById], references: [id])

  dependsOn  TaskDependency[] @relation("DependentTask")
  dependedBy TaskDependency[] @relation("DependencyTask")

  @@index([projectId])
  @@index([organizationId])
  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([projectId, status])
  @@index([organizationId, projectId])
}

model TaskDependency {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId      String   @db.ObjectId
  dependsOnId String   @db.ObjectId
  createdAt   DateTime @default(now())

  task      Task @relation("DependentTask", fields: [taskId], references: [id])
  dependsOn Task @relation("DependencyTask", fields: [dependsOnId], references: [id])

  @@unique([taskId, dependsOnId])
}

// ─────────────────────────────────────────
// DAILY REPORTS
// ─────────────────────────────────────────

model DailyReport {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @db.ObjectId
  projectId      String    @db.ObjectId
  reportDate     DateTime
  weather        String?
  temperature    String?
  achievements   String?
  blockers       String?
  notes          String?
  aiSummary      String?
  aiSummaryAt    DateTime?
  createdById    String    @db.ObjectId
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project         Project                    @relation(fields: [projectId], references: [id])
  createdBy       User                       @relation(fields: [createdById], references: [id])
  manpowerEntries DailyReportManpowerEntry[]
  materialEntries DailyReportMaterialEntry[]
  documents       Document[]

  @@unique([projectId, reportDate])
  @@index([projectId])
  @@index([organizationId])
}

model DailyReportManpowerEntry {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  dailyReportId String   @db.ObjectId
  trade         String
  count         Int
  contractor    String?
  notes         String?
  createdAt     DateTime @default(now())

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id])

  @@index([dailyReportId])
}

model DailyReportMaterialEntry {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  dailyReportId String   @db.ObjectId
  material      String
  quantity      Float
  unit          String
  notes         String?
  createdAt     DateTime @default(now())

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id])

  @@index([dailyReportId])
}

// ─────────────────────────────────────────
// ISSUES
// ─────────────────────────────────────────

model Issue {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String        @db.ObjectId
  projectId      String        @db.ObjectId
  title          String
  description    String?
  type           IssueType     @default(GENERAL)
  severity       IssueSeverity @default(MEDIUM)
  status         IssueStatus   @default(OPEN)
  assignedToId   String?       @db.ObjectId
  createdById    String?       @db.ObjectId
  resolvedAt     DateTime?
  closedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project    Project  @relation(fields: [projectId], references: [id])
  assignedTo User?    @relation("IssueAssignee", fields: [assignedToId], references: [id])
  createdBy  User?    @relation("IssueCreator", fields: [createdById], references: [id])
  documents  Document[]

  @@index([projectId])
  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([assignedToId])
}

// ─────────────────────────────────────────
// BUDGET
// ─────────────────────────────────────────

model Budget {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  projectId      String   @unique @db.ObjectId
  totalAmount    Float
  currency       String   @default("USD")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id])
  budgetLines BudgetLine[]
  expenses    Expense[]

  @@index([organizationId])
}

model BudgetLine {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  budgetId      String   @db.ObjectId
  category      String
  description   String?
  plannedAmount Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  budget         Budget          @relation(fields: [budgetId], references: [id])
  expenses       Expense[]
  purchaseOrders PurchaseOrder[]

  @@index([budgetId])
}

model Expense {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  budgetId       String?  @db.ObjectId
  budgetLineId   String?  @db.ObjectId
  description    String
  amount         Float
  currency       String   @default("USD")
  date           DateTime
  reference      String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  budget     Budget?     @relation(fields: [budgetId], references: [id])
  budgetLine BudgetLine? @relation(fields: [budgetLineId], references: [id])

  @@index([organizationId])
  @@index([budgetId])
}

// ─────────────────────────────────────────
// PROCUREMENT
// ─────────────────────────────────────────

model Supplier {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String    @db.ObjectId
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  website        String?
  isActive       Boolean   @default(true)
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  purchaseOrders PurchaseOrder[]
  externalUsers  User[]

  @@index([organizationId])
}

model PurchaseOrder {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  organizationId       String              @db.ObjectId
  projectId            String              @db.ObjectId
  supplierId           String              @db.ObjectId
  budgetLineId         String?             @db.ObjectId
  poNumber             String
  status               PurchaseOrderStatus @default(DRAFT)
  totalAmount          Float?
  currency             String              @default("USD")
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  notes                String?
  approvedById         String?             @db.ObjectId
  approvedAt           DateTime?
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  project    Project             @relation(fields: [projectId], references: [id])
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  budgetLine BudgetLine?         @relation(fields: [budgetLineId], references: [id])
  items      PurchaseOrderItem[]
  deliveries Delivery[]

  @@unique([organizationId, poNumber])
  @@index([projectId])
  @@index([supplierId])
  @@index([status])
  @@index([expectedDeliveryDate])
}

model PurchaseOrderItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId String   @db.ObjectId
  description     String
  quantity        Float
  unit            String?
  unitPrice       Float
  totalPrice      Float
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model Delivery {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String         @db.ObjectId
  purchaseOrderId String         @db.ObjectId
  deliveryDate    DateTime?
  status          DeliveryStatus @default(PENDING)
  receivedById    String?        @db.ObjectId
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@index([organizationId])
  @@index([status])
}

// ─────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────

model Document {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  projectId      String?      @db.ObjectId
  dailyReportId  String?      @db.ObjectId
  issueId        String?      @db.ObjectId
  type           DocumentType @default(OTHER)
  name           String
  description    String?
  fileKey        String
  fileUrl        String?
  mimeType       String?
  sizeBytes      Int?
  uploadedById   String?      @db.ObjectId
  metadata       Json?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project     Project?     @relation(fields: [projectId], references: [id])
  dailyReport DailyReport? @relation(fields: [dailyReportId], references: [id])
  issue       Issue?       @relation(fields: [issueId], references: [id])

  @@index([organizationId])
  @@index([projectId])
}

// ─────────────────────────────────────────
// AI
// ─────────────────────────────────────────

model AIInsight {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String            @db.ObjectId
  projectId      String            @db.ObjectId
  type           AIInsightType     @default(GENERAL)
  severity       AIInsightSeverity @default(MEDIUM)
  title          String
  message        String
  recommendation String?
  metadata       Json?
  isRead         Boolean           @default(false)
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([organizationId])
  @@index([severity])
  @@index([type])
  @@index([createdAt])
}

model ChatSession {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  projectId      String?  @db.ObjectId
  userId         String   @db.ObjectId
  title          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  messages     ChatMessage[]

  @@index([userId])
  @@index([projectId])
}

model ChatMessage {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  chatSessionId String   @db.ObjectId
  userId        String?  @db.ObjectId
  role          String
  content       String
  metadata      Json?
  createdAt     DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([chatSessionId])
}

// ─────────────────────────────────────────
// NOTIFICATIONS & AUDIT
// ─────────────────────────────────────────

model Notification {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  userId         String   @db.ObjectId
  title          String
  message        String
  type           String
  entityType     String?
  entityId       String?
  isRead         Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("NotificationUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  projectId      String?  @db.ObjectId
  actorUserId    String?  @db.ObjectId
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([organizationId])
  @@index([actorUserId])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────
// SUPPORT TICKETS
// ─────────────────────────────────────────

model SupportTicket {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String         @db.ObjectId
  subject        String
  description    String
  category       TicketCategory @default(GENERAL)
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  createdById    String         @db.ObjectId
  assignedToId   String?        @db.ObjectId
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  createdBy    User            @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo   User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  comments     TicketComment[]

  @@index([organizationId])
  @@index([status])
  @@index([createdById])
}

model TicketComment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String   @db.ObjectId
  userId     String   @db.ObjectId
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

// ─────────────────────────────────────────
// ORG SETTINGS
// ─────────────────────────────────────────

model OrgSettings {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String   @unique @db.ObjectId
  brandColor        String   @default("#1976d2")
  theme             String   @default("light")
  timezone          String   @default("America/New_York")
  currency          String   @default("USD")
  dateFormat        String   @default("MM/DD/YYYY")
  weekStart         String   @default("monday")
  measurement       String   @default("imperial")
  notifications     Json     @default("{}")
  twoFactorRequired Boolean  @default(false)
  passwordPolicy    String   @default("standard")
  sessionTimeoutMin Int      @default(480)
  ssoEnabled        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}
